{
  "name": "lot-clean",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.js test/batch-presentation.test.mjs test/browser-issuance.test.mjs test/lot-v2-session-store.test.mjs test/lot-v2-vault-isolation.test.mjs test/multi-policy.test.mjs test/onboarding-clearance.test.mjs test/onboarding-inspection.test.mjs test/onboarding.test.mjs test/preprod-public.test.mjs test/receipt-recovery.test.mjs test/issuance-budget.test.mjs test/cloud-runtime.test.mjs test/hosted-gateway.test.mjs test/public-onboarding.test.mjs",
    "compact:version": "node scripts/check-compact.mjs",
    "compact:compile": "compact compile contracts/lot.compact contracts/managed/lot",
    "test:midnight": "node --test test/contract.sim.test.mjs",
    "test:all": "npm test && npm run test:midnight && npm run test:midnight:v2",
    "test:network": "MIDNIGHT_NETWORK=local vitest run test/lot.network.test.ts",
    "chain:serve": "node scripts/lot-chain-server.mjs",
    "proof:serve": "node scripts/lot-proof-api.mjs",
    "test:roles": "MIDNIGHT_NETWORK=local vitest run test/lot.roles.test.ts",
    "vault:save": "node scripts/lot-vault-cli.mjs save",
    "vault:list": "node scripts/lot-vault-cli.mjs list",
    "vault:check": "node scripts/lot-vault-cli.mjs check",
    "vault:prove": "node scripts/lot-vault-prove.mjs",
    "inspector:init": "node scripts/lot-inspector-cli.mjs init",
    "inspector:trust-local": "node scripts/lot-inspector-cli.mjs trust-local",
    "inspector:trusted": "node scripts/lot-inspector-cli.mjs trusted",
    "inspector:attest": "node scripts/lot-inspector-cli.mjs attest",
    "inspector:check": "node scripts/lot-inspector-cli.mjs check",
    "vault:prove:attested": "LOT_REQUIRE_ATTESTATION=1 node scripts/lot-vault-prove.mjs",
    "test:network:v2": "MIDNIGHT_NETWORK=local vitest run test/lot.v2.network.test.ts",
    "vault:prove:v2": "node scripts/lot-v2-vault-prove.mjs",
    "vault:session:v2": "node scripts/lot-v2-session.mjs",
    "audit:session:v2": "node scripts/lot-v2-session-audit.mjs",
    "users:create": "node scripts/lot-local-operator-cli.mjs create",
    "users:list": "node scripts/lot-local-operator-cli.mjs list",
    "users:reset": "node scripts/lot-local-operator-cli.mjs reset",
    "preprod:doctor": "node scripts/lot-preprod-doctor.mjs",
    "preprod:configure": "node scripts/lot-preprod-configure.mjs",
    "preprod:audit": "node scripts/lot-preprod-audit.mjs",
    "test:midnight:v2": "node --test test/lot-v2.crypto.test.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-contracts": "^5.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^5.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^5.0.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^5.0.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^5.0.1",
    "@midnight-ntwrk/midnight-js-protocol": "^5.0.1",
    "@midnight-ntwrk/midnight-js-types": "^5.0.1",
    "@midnight-ntwrk/midnight-js-utils": "^5.0.1",
    "@midnight-ntwrk/testkit-js": "^5.0.1",
    "@midnightntwrk/wallet-sdk": "^2.0.1",
    "lucide-react": "^0.468.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@midnightntwrk/onchain-runtime-v4": "4.0.2",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/zkir-v3": "3.2.1"
  }
}
