    { "op": "bytes_into_natives", "outputs": ["%commitment.14", "%commitment.15"], "bytes": "%bytes.13" },
    { "op": "persistent_hash", "output": "%bytes.16", "alignment": [{ "tag": "atom", "value": { "length": 32, "tag": "bytes" } }, { "tag": "atom", "value": { "length": 32, "tag": "bytes" } }, { "tag": "atom", "value": { "length": 32, "tag": "bytes" } }], "inputs": ["0x00", "0x4c4f545f494e53505f5349474e5f5632", "%batchId.0", "%batchId.1", "%commitment.15", "%commitment.14"] },
    { "op": "bytes_into_natives", "outputs": ["%digest.17", "%digest.18"], "bytes": "%bytes.16" },
